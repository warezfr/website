---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import {
	Image,
	PortableText,
	Comments,
	CommentForm,
	WidgetArea,
} from "emdash/ui";
import Base from "../../layouts/Base.astro";
import MagCard from "../../components/MagCard.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");

Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	return undefined;
}

const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage: featuredImageUrl,
});

const categories = await getEntryTerms("posts", post.data.id, "category");
const tags = await getEntryTerms("posts", post.data.id, "tag");
const bylines = post.data.bylines ?? [];
const readingTime = getReadingTime(post.data.content);
const primaryCategory = categories[0] ?? null;

// Related posts (same primary category preferred)
const { entries: allRecent } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
});

// Resolve categories for related posts
const related = await Promise.all(
	allRecent
		.filter((p) => p.id !== post.id)
		.map(async (p) => {
			const cats = await getEntryTerms("posts", p.data.id, "category");
			return { post: p, categories: cats.map((c) => ({ slug: c.slug, label: c.label })) };
		})
);

const sameCatRelated = primaryCategory
	? related.filter((r) => r.categories.some((c) => c.slug === primaryCategory.slug))
	: [];
const otherRelated = related.filter(
	(r) => !sameCatRelated.find((s) => s.post.id === r.post.id)
);
const relatedPosts = [...sameCatRelated, ...otherRelated].slice(0, 3);

const publishDate = post.data.publishedAt?.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
}) ?? null;

const shareUrl = `${Astro.url.origin}/posts/${slug}`;
const shareTitle = encodeURIComponent(post.data.title ?? "");
const encodedUrl = encodeURIComponent(shareUrl);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={bylines[0]?.byline.displayName ?? null}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	{/* ============ READING PROGRESS BAR ============ */}
	<div class="read-progress" aria-hidden="true">
		<div class="read-progress__bar" id="read-progress-bar"></div>
	</div>

	{/* ============ ARTICLE HEADER ============ */}
	<header class="post-header">
		<div class="post-header__inner">
			<nav class="post-breadcrumbs" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span class="post-breadcrumbs__sep" aria-hidden="true">›</span>
				{primaryCategory ? (
					<>
						<a href={`/category/${primaryCategory.slug}`}>{primaryCategory.label}</a>
						<span class="post-breadcrumbs__sep" aria-hidden="true">›</span>
					</>
				) : (
					<>
						<a href="/posts">Articles</a>
						<span class="post-breadcrumbs__sep" aria-hidden="true">›</span>
					</>
				)}
				<span class="post-breadcrumbs__current">{post.data.title}</span>
			</nav>

			{primaryCategory && (
				<div class="post-header__cat">
					<CategoryBadge category={primaryCategory} />
				</div>
			)}

			<h1 class="post-title" {...post.edit.title}>{post.data.title}</h1>

			{post.data.excerpt && (
				<p class="post-dek" {...post.edit.excerpt}>{post.data.excerpt}</p>
			)}

			<div class="post-byline">
				{bylines.length > 0 && (
					<div class="post-byline__authors">
						{bylines[0].byline.avatarMediaId && (
							<img
								src={`/_emdash/api/media/file/${bylines[0].byline.avatarMediaId}`}
								alt={bylines[0].byline.displayName}
								class="post-byline__avatar"
							/>
						)}
						<div class="post-byline__text">
							<span class="post-byline__by">By</span>
							<span class="post-byline__names">
								{bylines.map((credit, i) => (
									<>
										{i > 0 && <span class="post-byline__sep">, </span>}
										<span class="post-byline__name">{credit.byline.displayName}</span>
									</>
								))}
							</span>
						</div>
					</div>
				)}
				<div class="post-byline__meta">
					{publishDate && <time>{publishDate}</time>}
					<span class="post-byline__dot" aria-hidden="true">·</span>
					<span>{readingTime} min read</span>
					<span class="post-byline__dot" aria-hidden="true">·</span>
					<a href="#comments" class="post-byline__link">Comments</a>
				</div>
			</div>
		</div>
	</header>

	{/* ============ HERO IMAGE ============ */}
	{post.data.featured_image && (
		<figure class="post-hero" {...post.edit.featured_image}>
			<div class="post-hero__inner">
				<Image image={post.data.featured_image} />
			</div>
		</figure>
	)}

	{/* ============ TWO-COLUMN BODY ============ */}
	<div class="post-body">
		<div class="post-body__inner">
			<aside class="post-share" aria-label="Share">
				<span class="post-share__label">Share</span>
				<a
					href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${shareTitle}`}
					target="_blank" rel="noopener"
					class="post-share__btn" aria-label="Share on X (Twitter)"
					data-testid="share-twitter"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
				<a
					href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
					target="_blank" rel="noopener"
					class="post-share__btn" aria-label="Share on LinkedIn"
					data-testid="share-linkedin"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.881 3.87 6 2.5 6S.02 4.881.02 3.5C.02 2.12 1.13 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22zm7.9 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 6.99V22h-4.56v-6.15c0-1.47-.03-3.36-2.05-3.36-2.05 0-2.37 1.6-2.37 3.26V22H8.12z"/></svg>
				</a>
				<a
					href={`https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${shareTitle}`}
					target="_blank" rel="noopener"
					class="post-share__btn" aria-label="Share on Hacker News"
					data-testid="share-hn"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M0 0v24h24V0zm6.25 4h2.5L12 10l3.25-6h2.5l-4.5 8.5V20h-2.5v-7.5z"/></svg>
				</a>
				<button
					type="button" class="post-share__btn"
					id="copy-link-btn" aria-label="Copy link"
					data-testid="share-copy"
					data-url={shareUrl}
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.71"/></svg>
				</button>
			</aside>

			<article class="post-content portable-text">
				<PortableText value={post.data.content} />
			</article>

			<aside class="post-sidebar" aria-label="Sidebar">
				<div class="post-sidebar__sticky">
					{/* Author card */}
					{bylines.length > 0 && (
						<section class="sb-card sb-author">
							<h4 class="sb-heading">About the author{bylines.length > 1 ? "s" : ""}</h4>
							{bylines.map((credit) => (
								<div class="sb-author__row">
									{credit.byline.avatarMediaId ? (
										<img
											src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
											alt={credit.byline.displayName}
											class="sb-author__avatar"
										/>
									) : (
										<div class="sb-author__avatar sb-author__avatar--placeholder" aria-hidden="true">
											{credit.byline.displayName?.[0] ?? "·"}
										</div>
									)}
									<div class="sb-author__info">
										<strong class="sb-author__name">{credit.byline.displayName}</strong>
										{credit.roleLabel && <span class="sb-author__role">{credit.roleLabel}</span>}
									</div>
								</div>
							))}
						</section>
					)}

					{/* Table of contents */}
					<nav class="sb-card sb-toc" aria-label="Table of contents" id="sb-toc">
						<h4 class="sb-heading">On this page</h4>
						<div id="toc-content" class="sb-toc__content"></div>
					</nav>

					{/* Tags */}
					{tags.length > 0 && (
						<section class="sb-card">
							<h4 class="sb-heading">Filed under</h4>
							<div class="sb-tags">
								{tags.map((t) => (
									<a href={`/tag/${t.slug}`} class="sb-tag">#{t.label}</a>
								))}
							</div>
						</section>
					)}

					{/* Newsletter mini CTA */}
					<section class="sb-card sb-newsletter">
						<h4 class="sb-heading">The weekly signal</h4>
						<p class="sb-newsletter__text">
							One email. Observability · Dynatrace · AI. Zero noise.
						</p>
						<form class="sb-newsletter__form" method="post" action="#" data-testid="sb-newsletter-form">
							<input
								type="email" required placeholder="you@work.email"
								class="sb-newsletter__input"
								data-testid="sb-newsletter-input"
							/>
							<button type="submit" class="sb-newsletter__btn" data-testid="sb-newsletter-submit">
								Subscribe
							</button>
						</form>
					</section>

					{/* EmDash auto-widgets (categories, recent posts, etc.) */}
					<section class="sb-card sb-widgets">
						<WidgetArea name="sidebar" />
					</section>
				</div>
			</aside>
		</div>
	</div>

	{/* ============ COMMENTS ============ */}
	<section class="post-comments" id="comments" data-testid="post-comments">
		<div class="post-comments__inner">
			<h2 class="post-comments__heading">
				<span class="post-comments__bar" aria-hidden="true"></span>
				Join the discussion
			</h2>
			<Comments collection="posts" contentId={post.data.id} threaded />
			<CommentForm collection="posts" contentId={post.data.id} />
		</div>
	</section>

	{/* ============ RELATED POSTS ============ */}
	{relatedPosts.length > 0 && (
		<section class="post-related" data-testid="post-related">
			<div class="post-related__inner">
				<header class="mag-section-title" data-cat={primaryCategory?.slug}>
					<h2><a href={primaryCategory ? `/category/${primaryCategory.slug}` : "/posts"}>Keep reading</a></h2>
					<a href="/posts">Browse archive →</a>
				</header>
				<div class="post-related__grid">
					{relatedPosts.map((r) => (
						<MagCard
							title={r.post.data.title ?? "Untitled"}
							excerpt={r.post.data.excerpt}
							featuredImage={r.post.data.featured_image}
							href={`/posts/${r.post.id}`}
							date={r.post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(r.post.data.content)}
							categories={r.categories}
							bylines={r.post.data.bylines ?? []}
							variant="stack"
							titleSize="md"
							showExcerpt
						/>
					))}
				</div>
			</div>
		</section>
	)}

	{/* ============ INLINE SCRIPTS ============ */}
	<script>
		// Build TOC from h2/h3 inside .post-content
		(function () {
			const content = document.querySelector(".post-content");
			const tocContainer = document.getElementById("toc-content");
			const tocWrap = document.getElementById("sb-toc");
			if (!content || !tocContainer || !tocWrap) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length < 2) { tocWrap.style.display = "none"; return; }

			const list = document.createElement("ul");
			list.className = "sb-toc__list";
			headings.forEach((h, i) => {
				if (!h.id) h.id = `heading-${i}`;
				const li = document.createElement("li");
				li.className = h.tagName === "H3" ? "sb-toc__item sb-toc__item--nested" : "sb-toc__item";
				const a = document.createElement("a");
				a.href = `#${h.id}`;
				a.className = "sb-toc__link";
				a.textContent = h.textContent;
				li.appendChild(a);
				list.appendChild(li);
			});
			tocContainer.appendChild(list);

			// Scroll spy
			const links = tocContainer.querySelectorAll<HTMLAnchorElement>(".sb-toc__link");
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						const id = e.target.id;
						const link = tocContainer.querySelector<HTMLAnchorElement>(`a[href="#${id}"]`);
						if (link && e.isIntersecting) {
							links.forEach((l) => l.classList.remove("active"));
							link.classList.add("active");
						}
					});
				},
				{ rootMargin: "-72px 0px -80% 0px" }
			);
			headings.forEach((h) => io.observe(h));
		})();

		// Reading progress
		(function () {
			const bar = document.getElementById("read-progress-bar");
			const content = document.querySelector(".post-content") as HTMLElement | null;
			if (!bar || !content) return;
			function update() {
				if (!content || !bar) return;
				const top = content.getBoundingClientRect().top + window.scrollY;
				const height = content.offsetHeight;
				const scroll = Math.max(0, window.scrollY - top + 60);
				const pct = Math.min(100, Math.max(0, (scroll / (height - window.innerHeight + 120)) * 100));
				bar.style.width = pct + "%";
			}
			update();
			window.addEventListener("scroll", update, { passive: true });
			window.addEventListener("resize", update);
		})();

		// Copy-link button
		(function () {
			const btn = document.getElementById("copy-link-btn") as HTMLButtonElement | null;
			if (!btn) return;
			btn.addEventListener("click", async () => {
				const url = btn.getAttribute("data-url") || location.href;
				try {
					await navigator.clipboard.writeText(url);
					btn.classList.add("copied");
					btn.setAttribute("aria-label", "Link copied!");
					setTimeout(() => {
						btn.classList.remove("copied");
						btn.setAttribute("aria-label", "Copy link");
					}, 1800);
				} catch (e) { /* noop */ }
			});
		})();
	</script>
</Base>

<style>
	/* ========== READING PROGRESS ========== */
	.read-progress {
		position: fixed;
		top: 0; left: 0; right: 0;
		height: 3px;
		background: transparent;
		z-index: 200;
		pointer-events: none;
	}
	.read-progress__bar {
		width: 0;
		height: 100%;
		background: var(--color-accent);
		transition: width 80ms ease;
	}

	/* ========== POST HEADER ========== */
	.post-header {
		padding: 2.5rem 1.5rem 1.5rem;
		background: var(--color-bg);
	}
	.post-header__inner {
		max-width: 760px;
		margin: 0 auto;
		text-align: left;
	}

	.post-breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-ui);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: 1.25rem;
	}
	.post-breadcrumbs a {
		color: var(--color-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 150ms ease;
	}
	.post-breadcrumbs a:hover { color: var(--color-accent); }
	.post-breadcrumbs__sep { color: var(--color-border); }
	.post-breadcrumbs__current {
		color: var(--color-text-secondary);
		font-weight: 500;
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		display: inline-block;
		max-inline-size: 380px;
	}

	.post-header__cat { margin-bottom: 1rem; }

	.post-title {
		font-family: var(--font-ui);
		font-size: clamp(1.875rem, 4.5vw, 3.25rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.024em;
		color: var(--color-text);
		margin-bottom: 1rem;
	}

	.post-dek {
		font-family: var(--font-display);
		font-size: clamp(1.125rem, 1.6vw, 1.375rem);
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin-bottom: 1.5rem;
		font-weight: 400;
		font-style: italic;
	}

	.post-byline {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-ui);
		font-size: 0.875rem;
	}
	.post-byline__authors {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.post-byline__avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}
	.post-byline__text {
		display: flex;
		flex-direction: column;
	}
	.post-byline__by {
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted);
		font-weight: 600;
	}
	.post-byline__names {
		font-weight: 600;
		color: var(--color-text);
	}
	.post-byline__meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-muted);
	}
	.post-byline__dot { opacity: 0.5; }
	.post-byline__link {
		color: var(--color-muted);
		text-decoration: none;
	}
	.post-byline__link:hover { color: var(--color-accent); }

	/* ========== HERO IMAGE ========== */
	.post-hero {
		margin: 2rem auto 0;
		padding: 0 1.5rem;
		max-width: var(--wide-width);
	}
	.post-hero__inner {
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		aspect-ratio: 16 / 9;
	}
	.post-hero__inner :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ========== TWO-COLUMN BODY ========== */
	.post-body {
		margin: 3rem auto 0;
		padding: 0 1.5rem;
		max-width: var(--wide-width);
		position: relative;
	}
	.post-body__inner {
		display: grid;
		grid-template-columns: 60px minmax(0, 720px) 300px;
		gap: 2rem;
		justify-content: center;
	}

	/* ========== SHARE RAIL (left) ========== */
	.post-share {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		position: sticky;
		top: calc(60px + 1.5rem);
		height: max-content;
		padding-top: 0.25rem;
	}
	.post-share__label {
		font-family: var(--font-ui);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		text-align: center;
		margin-bottom: 0.25rem;
	}
	.post-share__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 50%;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: all 180ms ease;
		text-decoration: none;
	}
	.post-share__btn:hover {
		color: var(--color-on-accent);
		background: var(--color-accent);
		border-color: var(--color-accent);
		transform: translateY(-1px);
	}
	.post-share__btn.copied {
		background: var(--cat-sre);
		border-color: var(--cat-sre);
		color: #fff;
	}
	.post-share__btn.copied::after {
		content: "Copied!";
		position: absolute;
		left: calc(100% + 0.75rem);
		background: var(--color-text);
		color: var(--color-bg);
		padding: 0.25rem 0.5rem;
		font-size: 0.6875rem;
		font-weight: 600;
