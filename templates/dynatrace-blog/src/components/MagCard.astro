---
/*
  MagCard — magazine-style post card.
  Variants:
    - "hero": big image, headline stacked below, category badge on top
    - "stack": image top + title + meta + excerpt
    - "row": small image left + headline/meta right (thumbnail list item)
    - "minimal": no image, just headline + meta
*/
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";
import CategoryBadge from "./CategoryBadge.astro";

interface Cat { slug: string; label: string; }

interface Props {
	title: string;
	excerpt?: string | null;
	featuredImage?: MediaValue | string | null;
	href: string;
	date?: Date | null;
	readingTime?: number;
	categories?: Cat[];
	bylines?: ContentBylineCredit[];
	variant?: "hero" | "stack" | "row" | "minimal";
	showExcerpt?: boolean;
	titleSize?: "sm" | "md" | "lg" | "xl";
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	categories = [],
	bylines,
	variant = "stack",
	showExcerpt = false,
	titleSize,
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("en-US", {
			month: "short",
			day: "numeric",
			year: "numeric",
		})
	: null;

const byline = bylines?.[0]?.byline;

const sizeClass = titleSize
	? `title-${titleSize}`
	: variant === "hero"
		? "title-xl"
		: variant === "stack"
			? "title-md"
			: variant === "row"
				? "title-sm"
				: "title-sm";
---

<article class:list={["mag-card", `mag-card--${variant}`]}>
	{variant !== "minimal" && featuredImage && (
		<a href={href} class="mag-card__image-link" aria-hidden="true" tabindex="-1">
			<div class="mag-card__image">
				<Image image={featuredImage} />
			</div>
			{categories.length > 0 && variant === "hero" && (
				<div class="mag-card__badge-overlay">
					<CategoryBadge category={categories[0]} />
				</div>
			)}
		</a>
	)}

	<div class="mag-card__body">
		{categories.length > 0 && variant !== "hero" && (
			<div class="mag-card__cat">
				<CategoryBadge category={categories[0]} />
			</div>
		)}

		<a href={href} class="mag-card__title-link">
			<h3 class:list={["mag-card__title", sizeClass]}>{title}</h3>
		</a>

		{showExcerpt && excerpt && (
			<p class="mag-card__excerpt">{excerpt}</p>
		)}

		<div class="mag-card__meta">
			{byline && <span class="mag-card__author">By {byline.displayName}</span>}
			{byline && formattedDate && <span class="mag-card__sep">·</span>}
			{formattedDate && <time>{formattedDate}</time>}
			{(formattedDate || byline) && readingTime && <span class="mag-card__sep">·</span>}
			{readingTime && <span>{readingTime} min</span>}
		</div>
	</div>
</article>

<style>
	.mag-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		position: relative;
	}

	.mag-card__image-link {
		display: block;
		position: relative;
		overflow: hidden;
		background: var(--color-surface);
		border-radius: var(--radius-lg);
	}

	.mag-card__image {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.mag-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
	}

	.mag-card:hover .mag-card__image :global(img) {
		transform: scale(1.05);
	}

	.mag-card__badge-overlay {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
	}

	.mag-card__cat {
		margin-bottom: 0.25rem;
	}

	.mag-card__title-link {
		text-decoration: none;
		color: inherit;
	}

	.mag-card__title {
		font-family: var(--font-ui);
		font-weight: 700;
		color: var(--color-text);
		letter-spacing: var(--tracking-tight);
		line-height: 1.18;
		margin: 0;
		transition: color 150ms ease;
	}

	.mag-card__title-link:hover .mag-card__title {
		color: var(--color-accent);
	}

	.title-sm { font-size: 1rem; line-height: 1.3; }
	.title-md { font-size: 1.25rem; line-height: 1.22; }
	.title-lg { font-size: 1.5rem; line-height: 1.18; }
	.title-xl { font-size: 1.875rem; line-height: 1.12; }

	.mag-card__excerpt {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.mag-card__meta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		color: var(--color-muted);
		flex-wrap: wrap;
	}

	.mag-card__author {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.mag-card__sep {
		opacity: 0.5;
	}

	/* Row variant — small thumb left, text right */
	.mag-card--row {
		flex-direction: row;
		gap: 0.85rem;
		align-items: flex-start;
	}

	.mag-card--row .mag-card__image-link {
		flex: 0 0 110px;
	}

	.mag-card--row .mag-card__image {
		aspect-ratio: 1 / 1;
		border-radius: var(--radius-lg);
	}

	.mag-card--row .mag-card__body {
		flex: 1;
		min-width: 0;
	}

	.mag-card--row .mag-card__title {
		font-size: 0.9375rem;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.mag-card--row .mag-card__cat { display: none; }
	.mag-card--row .mag-card__meta { margin-top: 0.25rem; }

	/* Hero variant — bigger title */
	.mag-card--hero .mag-card__title {
		font-size: clamp(1.25rem, 1.8vw, 1.75rem);
	}

	.mag-card--hero .mag-card__image {
		aspect-ratio: 4 / 3;
	}

	/* Minimal variant */
	.mag-card--minimal .mag-card__title {
		font-size: 1rem;
		line-height: 1.3;
	}
</style>
