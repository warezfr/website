---
/*
  ReviewScore — SmartMag-style circular review badge with animated ring.
  Displays score/max (e.g. 85/100), a label, and an optional verdict.
  Color adapts to the score band:
    0–49  red  (pan)
    50–69 amber
    70–84 blue
    85+   green
*/
interface Props {
	score: number;            // e.g. 85
	max?: number;             // default 100
	label?: string;           // e.g. "Dynatrace Club Score"
	verdict?: string;         // e.g. "Recommended"
	size?: "sm" | "md" | "lg";
	class?: string;
}

const {
	score,
	max = 100,
	label = "Our Score",
	verdict,
	size = "md",
	class: className,
} = Astro.props;

const pct = Math.max(0, Math.min(1, score / max));
const pctRounded = Math.round(pct * 100);

// Score band → color class
const band =
	score / max >= 0.85 ? "excellent" :
	score / max >= 0.70 ? "great" :
	score / max >= 0.50 ? "fair" : "poor";
---

<figure class:list={["review-score", `size-${size}`, `band-${band}`, className]} data-testid="review-score">
	<div class="review-score__ring" style={`--pct:${pct};`}>
		<svg viewBox="0 0 120 120" aria-hidden="true">
			<circle cx="60" cy="60" r="52" class="ring-track" />
			<circle
				cx="60" cy="60" r="52"
				class="ring-fill"
				pathLength="100"
				style={`stroke-dashoffset:${100 - pctRounded};`}
			/>
		</svg>
		<div class="review-score__inner">
			<span class="review-score__value">{score}</span>
			<span class="review-score__max">/ {max}</span>
		</div>
	</div>
	<figcaption class="review-score__caption">
		<span class="review-score__label">{label}</span>
		{verdict && <span class="review-score__verdict">{verdict}</span>}
	</figcaption>
</figure>

<style>
	.review-score {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		padding: 1.5rem 1.75rem;
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		margin: 0;
		text-align: center;
	}

	.review-score__ring {
		position: relative;
		width: 120px;
		height: 120px;
	}
	.size-sm .review-score__ring { width: 80px; height: 80px; }
	.size-lg .review-score__ring { width: 160px; height: 160px; }

	.review-score__ring svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
		overflow: visible;
	}

	.ring-track {
		fill: none;
		stroke: var(--color-border);
		stroke-width: 8;
	}

	.ring-fill {
		fill: none;
		stroke: var(--score-color, var(--color-accent));
		stroke-width: 10;
		stroke-linecap: round;
		stroke-dasharray: 100;
		transform-origin: center;
		animation: ring-draw 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
		filter: drop-shadow(0 0 8px color-mix(in srgb, var(--score-color, var(--color-accent)) 40%, transparent));
	}

	@keyframes ring-draw {
		from { stroke-dashoffset: 100; opacity: 0.4; }
		to { opacity: 1; }
	}

	.review-score__inner {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-family: var(--font-ui);
		line-height: 1;
	}

	.review-score__value {
		font-size: 2.125rem;
		font-weight: 800;
		color: var(--score-color, var(--color-text));
		letter-spacing: -0.02em;
	}
	.size-sm .review-score__value { font-size: 1.375rem; }
	.size-lg .review-score__value { font-size: 3rem; }

	.review-score__max {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-muted);
		margin-top: 0.2rem;
	}
	.size-lg .review-score__max { font-size: 1rem; margin-top: 0.35rem; }

	.review-score__caption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.review-score__label {
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.review-score__verdict {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 500;
		font-size: 0.9375rem;
		color: var(--score-color, var(--color-text));
	}

	/* Color bands */
	.band-excellent { --score-color: #059669; }
	.band-great     { --score-color: #1d4ed8; }
	.band-fair      { --score-color: #f59e0b; }
	.band-poor      { --score-color: #dc2626; }

	:root.dark .band-excellent { --score-color: #34d399; }
	:root.dark .band-great     { --score-color: #60a5fa; }
	:root.dark .band-fair      { --score-color: #fbbf24; }
	:root.dark .band-poor      { --score-color: #f87171; }
</style>

<!--
  Smaller corner badge variant — can be dropped on top of a featured image.
  Usage: <ReviewScoreBadge score={85} />
  Uses the same CSS via .review-score-badge class below.
-->
