---
import { getMenu, getEmDashCollection, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const { siteTitle, siteTagline, siteLogo, siteFavicon } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

const menu = await getMenu("primary");
const { entries: pages } = await getEmDashCollection("pages");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
const buildYear = new Date().getFullYear();
const now = new Date();
const formattedToday = now.toLocaleDateString("en-US", {
	weekday: "long",
	month: "long",
	day: "numeric",
	year: "numeric",
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{siteFavicon && <link rel="icon" href={siteFavicon} />}
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		{/* ========== TOP BAR ========== */}
		<div class="topbar">
			<div class="topbar__inner">
				<div class="topbar__left">
					<span class="topbar__date">{formattedToday}</span>
					<span class="topbar__sep" aria-hidden="true">·</span>
					<span class="topbar__tagline">Observability · Dynatrace · AI</span>
				</div>
				<div class="topbar__right">
					<a href="/rss.xml" class="topbar__link" data-testid="topbar-rss">RSS</a>
					<a href="#newsletter" class="topbar__link">Subscribe</a>
					<div class="topbar__theme">
						<button type="button" class="theme-btn" data-theme="light" aria-label="Light mode" data-testid="theme-light">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
						</button>
						<button type="button" class="theme-btn" data-theme="dark" aria-label="Dark mode" data-testid="theme-dark">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
						</button>
					</div>
					{isLoggedIn && <a href="/_emdash/admin" class="topbar__admin" data-testid="admin-link">Admin</a>}
				</div>
			</div>
		</div>

		{/* ========== MAIN HEADER ========== */}
		<header class="site-header">
			<div class="site-header__inner">
				<a href="/" class="site-brand" data-testid="site-title-link">
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-brand__logo" />
						: (
							<>
								<span class="site-brand__mark" aria-hidden="true">
									<span class="site-brand__pulse"></span>
								</span>
								<span class="site-brand__name">
									Dynatrace<span class="site-brand__dot">.</span>Club
								</span>
							</>
						)
					}
				</a>
				<p class="site-header__tagline">{siteTagline}</p>
			</div>
		</header>

		{/* ========== NAVIGATION BAR ========== */}
		<nav class="navbar" aria-label="Primary">
			<div class="navbar__inner">
				<ul class="navbar__links" data-testid="nav-menu">
					<li><a href="/" data-testid="nav-home">Home</a></li>
					{menu?.items.map((item) => (
						<li>
							<a href={item.url} target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>
								{item.label}
							</a>
						</li>
					))}
				</ul>
				<div class="navbar__search">
					<LiveSearch
						placeholder="Search the club..."
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
					/>
				</div>
			</div>
		</nav>

		<main>
			<slot />
		</main>

		{/* ========== FOOTER ========== */}
		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__grid">
					<div class="site-footer__brand">
						<a href="/" class="site-footer__logo">Dynatrace<span>.</span>Club</a>
						<p class="site-footer__tagline">{siteTagline}</p>
					</div>
					<div class="site-footer__col">
						<h4 class="site-footer__heading">Navigate</h4>
						<ul>
							<li><a href="/">Home</a></li>
							<li><a href="/posts">All Posts</a></li>
							{pages.slice(0, 3).map((page) => (
								<li><a href={`/pages/${page.data.slug || page.id}`}>{page.data.title}</a></li>
							))}
						</ul>
					</div>
					<div class="site-footer__col">
						<h4 class="site-footer__heading">Topics</h4>
						<ul>
							<li><a href="/category/observability">Observability</a></li>
							<li><a href="/category/dynatrace">Dynatrace</a></li>
							<li><a href="/category/ai">AI</a></li>
							<li><a href="/category/sre">SRE &amp; Reliability</a></li>
						</ul>
					</div>
					<div class="site-footer__col site-footer__widgets">
						<WidgetArea name="footer" />
					</div>
				</div>
				<div class="site-footer__bottom">
					<p>&copy; {buildYear} Dynatrace Club &middot; All rights reserved.</p>
					<p class="site-footer__stack">
						Built on <a href="https://emdashcms.com" rel="noopener">EmDash</a> &amp; <a href="https://astro.build" rel="noopener">Astro</a>
					</p>
				</div>
			</div>
		</footer>

		{/* ========== THEME SWITCHER JS ========== */}
		<script>
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(name: string, value: string, maxAge: number = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						root.classList.add("dark");
					}
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					btn.classList.toggle("active", btn.dataset.theme === theme);
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			const storedTheme = getStoredTheme();
			updateActiveBtn(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					const current = btn.dataset.theme || "system";
					// toggle between light/dark on double-click, otherwise set directly
					setTheme(current === "dark" && root.classList.contains("dark") ? "light" : current);
				});
			});

			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const s = document.querySelector(".site-search-input") as HTMLInputElement | null;
					if (s) s.focus();
				}
			});
		</script>

		{/* ========== LAYOUT STYLES ========== */}
		<style is:global>
			@layer base;

			@layer base {
				*, *::before, *::after { box-sizing: border-box; }
				body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure, blockquote, dl, dd { margin: 0; }
				ul, ol { padding: 0; list-style: none; }
				html { scroll-behavior: smooth; }
				body {
					font-family: var(--font-sans, system-ui);
					font-size: 1rem;
					line-height: 1.55;
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}
				a { color: var(--color-accent); text-decoration: none; transition: color 150ms ease; }
				a:hover { color: var(--color-accent-hover); }
				img { max-width: 100%; height: auto; display: block; }
			}
		</style>

		<style>
			/* ========== TOP BAR ========== */
			.topbar {
				background: var(--color-topbar-bg);
				color: var(--color-topbar-text);
				font-family: var(--font-ui);
				font-size: 0.75rem;
			}

			.topbar__inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 1.5rem;
				height: var(--topbar-height);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
			}

			.topbar__left { display: flex; align-items: center; gap: 0.5rem; }
			.topbar__date { font-weight: 500; color: var(--color-topbar-text); }
			.topbar__sep { color: var(--color-topbar-muted); }
			.topbar__tagline { color: var(--color-topbar-muted); letter-spacing: 0.04em; }

			.topbar__right { display: flex; align-items: center; gap: 1.25rem; }

			.topbar__link {
				color: var(--color-topbar-text);
				font-weight: 500;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				font-size: 0.6875rem;
			}

			.topbar__link:hover { color: #fff; }

			.topbar__theme {
				display: flex;
				gap: 0.25rem;
				padding: 2px;
				background: rgba(255, 255, 255, 0.06);
				border-radius: 3px;
			}

			.theme-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 24px;
				height: 20px;
				background: transparent;
				border: none;
				color: var(--color-topbar-muted);
				border-radius: 2px;
				cursor: pointer;
				transition: all 150ms ease;
			}

			.theme-btn:hover { color: #fff; }
			.theme-btn.active { background: rgba(255, 255, 255, 0.14); color: #fff; }

			.topbar__admin {
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-accent);
				font-weight: 700;
			}

			/* ========== MAIN HEADER (centered brand) ========== */
			.site-header {
				padding: 2.25rem 1.5rem 1.5rem;
				text-align: center;
				background: var(--color-bg);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.site-header__inner {
				max-width: var(--wide-width);
				margin: 0 auto;
			}

			.site-brand {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				color: var(--color-text);
				text-decoration: none;
				font-family: var(--font-ui);
			}

			.site-brand__mark {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				background: var(--color-accent);
				border-radius: 50%;
				position: relative;
			}

			.site-brand__pulse {
				position: absolute;
				inset: 0;
				border-radius: 50%;
				background: var(--color-accent);
				opacity: 0.35;
				animation: brand-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
			}

			@keyframes brand-pulse {
				0% { transform: scale(1); opacity: 0.35; }
				100% { transform: scale(1.8); opacity: 0; }
			}

			.site-brand__name {
				font-size: clamp(1.75rem, 4vw, 2.75rem);
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--color-text);
				line-height: 1;
			}

			.site-brand__dot { color: var(--color-accent); }
			.site-brand__logo { height: 52px; width: auto; }

			.site-header__tagline {
				margin-top: 0.6rem;
				font-size: 0.8125rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--color-muted);
				font-weight: 500;
			}

			/* ========== NAV BAR ========== */
			.navbar {
				position: sticky;
				top: 0;
				z-index: 100;
				background: var(--color-bg);
				border-bottom: 1px solid var(--color-border);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}

			:root.dark .navbar {
				background: color-mix(in srgb, var(--color-bg) 85%, transparent);
			}

			.navbar__inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 1.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1.5rem;
				height: 52px;
			}

			.navbar__links {
				display: flex;
				gap: 2rem;
				align-items: center;
			}

			.navbar__links a {
				font-family: var(--font-ui);
				font-size: 0.8125rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-text);
				text-decoration: none;
				position: relative;
				padding: 4px 0;
				transition: color 150ms ease;
			}

			.navbar__links a::after {
				content: "";
				position: absolute;
				left: 0; right: 0;
				bottom: -2px;
				height: 2px;
				background: var(--color-accent);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 200ms ease;
			}

			.navbar__links a:hover {
				color: var(--color-accent);
			}

			.navbar__links a:hover::after { transform: scaleX(1); }

			.navbar__search { width: 220px; flex-shrink: 0; }

			:global(.site-search-input) {
				width: 100%;
				padding: 0.4rem 0.75rem;
				font-family: var(--font-ui);
				font-size: 0.8125rem;
				color: var(--color-text);
				background: var(--color-surface);
				border: 1px solid transparent;
				border-radius: var(--radius);
				transition: all 150ms ease;
			}

			:global(.site-search-input)::placeholder { color: var(--color-muted); }

			:global(.site-search-input):focus {
				outline: none;
				border-color: var(--color-accent);
				background: var(--color-bg);
				box-shadow: 0 0 0 3px var(--color-accent-ring);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				right: 0;
				left: auto;
				width: 340px;
				margin-top: 0.5rem;
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-dropdown);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-result) {
				display: block;
				padding: 0.75rem 1rem;
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			:global(.site-search-result):hover,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block; font-weight: 600; font-size: 0.875rem;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block; font-size: 0.8125rem; color: var(--color-muted);
				margin-top: 0.15rem;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: 1rem; text-align: center; color: var(--color-muted); font-size: 0.875rem;
			}

			main { min-height: 60vh; }

			/* ========== FOOTER ========== */
			.site-footer {
				background: var(--color-bg-subtle);
				border-top: 4px solid var(--color-accent);
				margin-top: 4rem;
			}

			.site-footer__inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.5rem 1.5rem;
			}

			.site-footer__grid {
				display: grid;
				grid-template-columns: 2fr 1fr 1fr 1fr;
				gap: 2.5rem;
				margin-bottom: 2.5rem;
			}

			.site-footer__brand { max-width: 320px; }

			.site-footer__logo {
				display: inline-block;
				font-family: var(--font-ui);
				font-size: 1.5rem;
				font-weight: 800;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: -0.02em;
			}

			.site-footer__logo span { color: var(--color-accent); }

			.site-footer__tagline {
				margin-top: 0.75rem;
				font-size: 0.875rem;
				line-height: 1.6;
				color: var(--color-text-secondary);
			}

			.site-footer__heading {
				font-family: var(--font-ui);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--color-text);
				margin-bottom: 1rem;
			}

			.site-footer__col ul li { margin-bottom: 0.5rem; }

			.site-footer__col a {
				color: var(--color-text-secondary);
				font-size: 0.875rem;
				text-decoration: none;
			}

			.site-footer__col a:hover { color: var(--color-accent); }

			.site-footer__widgets :global(.widget__title) {
				font-family: var(--font-ui);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--color-text);
				margin-bottom: 1rem;
			}

			.site-footer__widgets :global(.widget__content) {
				font-size: 0.875rem;
				color: var(--color-text-secondary);
				line-height: 1.6;
			}

			.site-footer__bottom {
				padding-top: 1.5rem;
				border-top: 1px solid var(--color-border);
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.8125rem;
				color: var(--color-muted);
			}

			.site-footer__stack a { color: var(--color-text-secondary); font-weight: 500; }
			.site-footer__stack a:hover { color: var(--color-accent); }

			/* ========== RESPONSIVE ========== */
			@media (max-width: 820px) {
				.topbar__left .topbar__tagline { display: none; }
				.topbar__left .topbar__sep { display: none; }
				.navbar__search { display: none; }
				.navbar__links { gap: 1rem; overflow-x: auto; }
				.navbar__inner { padding: 0 1rem; }
				.site-footer__grid { grid-template-columns: 1fr 1fr; }
				.site-footer__brand { grid-column: span 2; max-width: none; }
				.site-header { padding: 1.75rem 1rem 1.25rem; }
			}

			@media (max-width: 520px) {
				.topbar__inner { padding: 0 0.75rem; }
				.topbar__right { gap: 0.75rem; }
				.topbar__link { display: none; }
				.site-brand__name { font-size: 1.75rem; }
				.site-header__tagline { font-size: 0.6875rem; }
				.site-footer__grid { grid-template-columns: 1fr; }
				.site-footer__brand { grid-column: 1; }
				.site-footer__bottom { flex-direction: column; }
			}
		</style>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
